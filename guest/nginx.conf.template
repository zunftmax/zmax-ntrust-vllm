load_module /usr/lib/nginx/modules/ngx_http_acme_module.so;

daemon off;
worker_processes 1;
pid /run/ntrust-web/nginx.pid;
# NGINX error messages can include request lines. Never retain either log.
error_log /dev/null;

events {
    worker_connections 256;
}

http {
    access_log off;
    server_tokens off;
    resolver 127.0.0.53 ipv6=off;
    resolver_timeout 10s;
    limit_conn_zone $server_name zone=global_connections:32k;
    limit_conn_zone $binary_remote_addr zone=client_connections:64k;
    limit_req_zone $binary_remote_addr zone=client_requests:64k rate=2r/s;
    limit_conn_status 429;
    limit_req_status 429;
    limit_conn global_connections 4;
    limit_conn client_connections 2;
    limit_req zone=client_requests burst=4 nodelay;

    client_header_timeout 10s;
    client_body_timeout 30s;
    client_max_body_size 1m;
    large_client_header_buffers 2 8k;
    keepalive_timeout 60s;
    send_timeout 60s;
    client_body_temp_path /run/ntrust-web/body;
    proxy_temp_path /run/ntrust-web/proxy;
    fastcgi_temp_path /run/ntrust-web/fastcgi;
    uwsgi_temp_path /run/ntrust-web/uwsgi;
    scgi_temp_path /run/ntrust-web/scgi;

    acme_issuer letsencrypt {
        uri ${NTRUST_ACME_DIRECTORY};
        contact mailto:${NTRUST_EMAIL};
        challenge tls-alpn-01;
        state_path off;
        ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        accept_terms_of_service;
    }
    acme_shared_zone zone=ntrust_acme:256k;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host 127.0.0.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_max_temp_file_size 0;
    proxy_next_upstream off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 300s;
    proxy_send_timeout 30s;

    server {
        listen 443 ssl;
        server_name ${NTRUST_DOMAIN};
        ssl_protocols TLSv1.3;
        ssl_session_tickets off;
        acme_certificate letsencrypt;
        ssl_certificate $acme_certificate;
        ssl_certificate_key $acme_certificate_key;
        ssl_certificate_cache max=2;

        location = /v1/attest {
            if ($request_method != GET) { return 405; }
            proxy_pass http://127.0.0.1:8082;
        }
        location = /v1/models {
            if ($request_method != GET) { return 405; }
            proxy_pass http://127.0.0.1:8080;
        }
        location = /v1/chat/completions {
            if ($request_method != POST) { return 405; }
            proxy_pass http://127.0.0.1:8080;
        }
        location / {
            return 404;
        }
    }
}
