[Unit]
Description=IETF RATS composite remote attestation responder
BindsTo=ntrust-gpu.service
After=ntrust-gpu.service
ConditionPathExists=/etc/ntrust/runtime.env

[Service]
Type=simple
EnvironmentFile=/etc/ntrust/runtime.env
ExecStart=/usr/bin/python3 /usr/local/lib/ntrust/attest-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=~@mount @module @raw-io @reboot @swap @debug @obsolete bpf keyctl add_key request_key
SystemCallErrorNumber=EPERM
ProtectSystem=strict
ProtectHome=yes
TemporaryFileSystem=/tmp:rw,nosuid,nodev,noexec,mode=1777 /var/tmp:rw,nosuid,nodev,noexec,mode=1777
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressAllow=127.0.0.1/32
IPAddressDeny=any
LimitCORE=0
MemorySwapMax=0
MemoryMax=128M
TasksMax=16
UMask=0077
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
