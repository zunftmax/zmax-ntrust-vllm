NTRUST_DOMAIN=inference.example.com
NTRUST_EMAIL=admin@example.com
# Use staging during setup; remove this line for public trusted certificates.
NTRUST_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
# Set to 1 for zero-operator confidential mode (disables SSH remote administration)
# NTRUST_NO_SSH=1

# Rust attestation source is prepared but service activation awaits hardware acceptance.
# The installed service defaults to gpu; do not infer origin GPU proof from a relay.
# Optional TDX measured-boot evidence (verified only with a customer boot policy):
# NTRUST_TDX_BOOT_LOG=/sys/firmware/acpi/tables/data/CCEL
