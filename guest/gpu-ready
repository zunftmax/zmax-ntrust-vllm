#!/bin/bash
set -euo pipefail
export LC_ALL=C
# This gate verifies the attached GPU locally. Customer verification of the
# CPU/image/TLS identity is separate and is not implemented here.
case "$(systemd-detect-virt --cvm)" in
    sev-snp|tdx) ;;
    *) echo 'An AMD SEV-SNP or Intel TDX VM is required.' >&2; exit 1 ;;
esac
test "$(wc -l < /proc/swaps)" -eq 1 || {
    echo 'Swap must be disabled before accepting inference.' >&2
    exit 1
}
gpu_uuids=$(nvidia-smi --query-gpu=uuid --format=csv,noheader)
if [ -z "$gpu_uuids" ] || [ "$(printf '%s\n' "$gpu_uuids" | wc -l)" -ne 1 ]; then
    echo 'Exactly one confidential GPU is required.' >&2
    exit 1
fi
nvidia-smi conf-compute -f | grep -Eq '^[[:space:]]*CC status: ON[[:space:]]*$' || {
    echo 'NVIDIA production CC-On mode is required.' >&2
    exit 1
}
# NVIDIA generates a fresh nonce, collects live NVML evidence and verifies its
# signatures, measurements, RIMs and certificate revocation status. Its default
# overall-result policy must pass; no bypass policy, file evidence or NRAS.
# The CLI returns a nonzero status for verification failure. Keep evidence in RAM.
verified=false
for attempt in 1 2 3; do
    if timeout --kill-after=2 45 nvattest --log-level error --format json attest \
        --device gpu --gpu-evidence-source nvml --verifier local \
        > /run/ntrust-gpu/attestation.json; then
        verified=true
        break
    fi
    rm -f /run/ntrust-gpu/attestation.json
    if [ "$attempt" -lt 3 ]; then sleep 5; fi
done
if [ "$verified" != true ]; then
    echo 'GPU verification failed after three bounded attempts.' >&2
    exit 1
fi
nvidia-smi conf-compute -srs 1
nvidia-smi conf-compute -grs | grep -Eq '^[[:space:]]*Confidential Compute GPUs Ready state: ready[[:space:]]*$'

# One client credential per boot, generated only after verification. Preserve it
# across service restarts; neither it nor the TLS private key belongs on disk.
umask 077
if [ ! -s /run/ntrust-gpu/api-key ]; then
    openssl rand -hex 32 > /run/ntrust-gpu/api-key
fi
