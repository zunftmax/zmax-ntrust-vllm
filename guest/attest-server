#!/usr/bin/env python3
"""Local HTTP transport for Rust uq composite collection.

Only the pinned Rust binary collects evidence. This adapter emits no verification
verdict, performs no CPU/GPU appraisal, and never reuses an admission JSON file.
The independent client verifies the CPU/GPU evidence with its enrolled policy.
"""
import hashlib
from http.server import BaseHTTPRequestHandler, HTTPServer
import json
import os
from pathlib import Path
import re
import socket
import ssl
import stat
import subprocess
import tempfile
from urllib.parse import parse_qs, urlparse

EAT_PROFILE = "https://uq.secure.build/eat/v2"
NONCE_RE = re.compile(r"^[0-9a-f]{64}$")
MAX_EVIDENCE_BYTES = 64 * 1024 * 1024
COLLECTION_TIMEOUT = 240
UQ_BINARY = Path("/usr/local/bin/uq")
UQ_RELEASE = Path("/usr/share/doc/ntrust/uq-release.json")
RUNTIME_DIR = Path("/run/ntrust-attest")

DEFAULT_MEASURED_PATHS = (
    '/boot/config-7.2.10-ntrust',
    '/boot/vmlinuz-7.2.10-ntrust',
    '/etc/ntrust/model.json',
    '/etc/ntrust/nginx.conf.template',
    '/etc/systemd/system/ntrust-attest.service',
    '/etc/systemd/system/ntrust-gpu.service',
    '/etc/systemd/system/ntrust-https.service',
    '/etc/systemd/system/ntrust-inference.service',
    '/usr/local/bin/ntrust-status',
    '/usr/local/bin/uq',
    '/usr/local/lib/ntrust/attest-server',
    '/usr/local/lib/ntrust/fetch-model',
    '/usr/local/lib/ntrust/gpu-ready',
    '/usr/local/lib/ntrust/https-start',
    '/usr/local/lib/ntrust/inference-ready',
    '/usr/local/lib/ntrust/inference-start',
    '/usr/share/doc/ntrust/requirements.lock',
    '/usr/share/doc/ntrust/uq-release.json',
)


def _read_asn1_tlv(data: bytes, offset: int) -> tuple[int, int, int, int]:
    """Return (tag, value_start, value_end, next_offset) for a DER TLV."""
    if offset >= len(data):
        raise ValueError("Truncated ASN.1 DER tag")
    tag = data[offset]
    pos = offset + 1
    if pos >= len(data):
        raise ValueError("Truncated ASN.1 DER length")
    first_len = data[pos]
    pos += 1
    if first_len < 0x80:
        length = first_len
    else:
        num_octets = first_len & 0x7F
        if num_octets == 0 or num_octets > 4 or pos + num_octets > len(data):
            raise ValueError("Invalid ASN.1 DER length octets")
        length = int.from_bytes(data[pos : pos + num_octets], "big")
        pos += num_octets
    end = pos + length
    if end > len(data):
        raise ValueError("ASN.1 DER value exceeds buffer")
    return tag, pos, end, end


def extract_spki_der(cert_der: bytes) -> bytes:
    """Extract the exact DER-encoded SubjectPublicKeyInfo TLV from an X.509 cert."""
    tag, cert_start, _, _ = _read_asn1_tlv(cert_der, 0)
    if tag != 0x30:
        raise ValueError("X.509 Certificate must start with SEQUENCE")
    tbs_tag, tbs_start, tbs_end, _ = _read_asn1_tlv(cert_der, cert_start)
    if tbs_tag != 0x30:
        raise ValueError("TBSCertificate must be a SEQUENCE")
    pos = tbs_start
    first_tag, _, _, next_pos = _read_asn1_tlv(cert_der, pos)
    if first_tag == 0xA0:
        pos = next_pos
    for _ in range(5):
        _, _, _, pos = _read_asn1_tlv(cert_der, pos)
    spki_tag, _, _, spki_end = _read_asn1_tlv(cert_der, pos)
    if spki_tag != 0x30 or spki_end > tbs_end:
        raise ValueError("Invalid SubjectPublicKeyInfo SEQUENCE in TBSCertificate")
    return cert_der[pos:spki_end]


def digest_regular_file(path: Path, algorithm: str) -> bytes:
    """Hash one required regular file without following a final symlink."""
    if not path.is_absolute():
        raise RuntimeError("Measured file paths must be absolute")
    for parent in path.parents:
        if parent.is_symlink():
            raise RuntimeError(f"Measured path traverses a symlink: {path}")
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_size > 512 * 1024 * 1024:
            raise RuntimeError(f"Required measured file is nonregular or oversized: {path}")
    except BaseException:
        os.close(descriptor)
        raise
    with os.fdopen(descriptor, "rb") as stream:
        digest, total = hashlib.new(algorithm), 0
        while chunk := stream.read(1024 * 1024):
            total += len(chunk)
            if total > 512 * 1024 * 1024:
                raise RuntimeError("Measured file grew beyond the byte limit")
            digest.update(chunk)
        after = os.fstat(stream.fileno())
        current = path.lstat()
        identity = lambda info: (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)
        if total != before.st_size or identity(before) != identity(after) or identity(after) != identity(current):
            raise RuntimeError(f"Measured file changed during hashing: {path}")
        return digest.digest()


def compute_value_x(paths: tuple[str, ...] = DEFAULT_MEASURED_PATHS) -> bytes:
    """Hash the complete required Ntrust file manifest; absent files are errors.

    The approved Value X must be enrolled independently for this exact manifest.
    This is an application-file closure, not a signed boot log or full disk hash.
    Entries use the uq tree-hash encoding: relative path, colon, SHA-384, newline.
    """
    if not paths or len(set(paths)) != len(paths):
        raise RuntimeError("Measured file manifest is empty or contains duplicates")
    digest = hashlib.sha384()
    for raw in sorted(paths):
        path = Path(raw)
        if not path.is_absolute() or str(path) != raw or any(c in raw for c in ("\n", "\r", "\0")):
            raise RuntimeError("Measured path is not canonical")
        digest.update(raw.lstrip("/").encode("utf-8"))
        digest.update(b":")
        digest.update(digest_regular_file(path, "sha384"))
        digest.update(b"\n")
    return digest.digest()


def require_pinned_uq(binary: Path = UQ_BINARY, release: Path = UQ_RELEASE) -> None:
    """Check the installed bytes against the build-host verified release record."""
    if binary.is_symlink() or not binary.is_file() or not os.access(binary, os.X_OK):
        raise RuntimeError("The pinned Rust uq executable is unavailable")
    if release.is_symlink() or not release.is_file() or release.stat().st_size > 4096:
        raise RuntimeError("The verified uq release record is unavailable")
    record = json.loads(release.read_text())
    expected = record.get("binary_sha256", "")
    if not re.fullmatch(r"[0-9a-f]{64}", expected):
        raise RuntimeError("The uq binary SHA-256 pin is invalid")
    actual = digest_regular_file(binary, "sha256").hex()
    if actual != expected:
        raise RuntimeError("The installed uq binary differs from its approved pin")


def fetch_live_tls_cert_der(domain: str, port: int = 443) -> bytes:
    """Observe the current local TLS key; the customer authenticates its own TLS peer."""
    # Certificate trust is checked by the remote customer. Here the listener is
    # fixed to loopback and only its current key is committed into fresh evidence.
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_3
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    with socket.create_connection(("127.0.0.1", port), timeout=5) as sock:
        with ctx.wrap_socket(sock, server_hostname=domain) as stream:
            cert = stream.getpeercert(binary_form=True)
            if not cert or len(cert) > 64 * 1024:
                raise RuntimeError("Local TLS listener returned no bounded certificate")
            return cert


def build_rats_evidence(nonce_hex: str) -> dict:
    """Return raw Rust EAT JSON, or fail; never construct a substitute receipt."""
    if not NONCE_RE.fullmatch(nonce_hex):
        raise ValueError("nonce must be exactly 64 lowercase hexadecimal characters")
    mode = os.environ.get("NTRUST_ATTEST_MODE")
    if mode not in ("gpu", "cpu-only"):
        raise RuntimeError("NTRUST_ATTEST_MODE must explicitly select gpu or cpu-only")
    domain = os.environ.get("NTRUST_DOMAIN", "")
    if not domain:
        raise RuntimeError("NTRUST_DOMAIN is required")
    require_pinned_uq()
    spki = extract_spki_der(fetch_live_tls_cert_der(domain))
    value_x = compute_value_x().hex()
    if not RUNTIME_DIR.is_dir() or RUNTIME_DIR.is_symlink():
        raise RuntimeError("Private attestation runtime directory is unavailable")
    # systemd provisions this RAM directory with mode 0700. Each request owns
    # its nonce, observed SPKI and output; no static GPU admission result is read.
    with tempfile.TemporaryDirectory(prefix="request-", dir=RUNTIME_DIR) as name:
        work = Path(name)
        spki_path, output = work / "tls-spki.der", work / "receipt.json"
        spki_path.write_bytes(spki)
        command = [str(UQ_BINARY), "collect", "--nonce", nonce_hex,
                   "--tls-spki", str(spki_path), "--value-x", value_x,
                   "--out", str(output), "--format", "json"]
        if mode == "gpu":
            topology = os.environ.get("NTRUST_GPU_TOPOLOGY", "auto")
            if topology not in ("auto", "independent", "ppcie"):
                raise RuntimeError("Invalid NTRUST_GPU_TOPOLOGY")
            command.extend(["--gpu", "--topology", topology])
        boot_log = os.environ.get("NTRUST_TDX_BOOT_LOG")
        if boot_log:
            if not Path(boot_log).is_absolute():
                raise RuntimeError("NTRUST_TDX_BOOT_LOG must be an absolute path")
            command.extend(["--boot-log", boot_log])
        try:
            result = subprocess.run(command, stdin=subprocess.DEVNULL,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                    timeout=COLLECTION_TIMEOUT, check=False)
        except subprocess.TimeoutExpired as error:
            raise RuntimeError("Rust evidence collection timed out") from error
        except OSError as error:
            raise RuntimeError("Rust evidence collection could not start") from error
        if result.returncode != 0:
            raise RuntimeError(f"Rust evidence collection failed (exit {result.returncode})")
        with output.open("rb") as stream:
            raw = stream.read(MAX_EVIDENCE_BYTES + 1)
        if not raw or len(raw) > MAX_EVIDENCE_BYTES:
            raise RuntimeError("Rust evidence output is empty or oversized")
        try:
            token = json.loads(raw)
        except (ValueError, UnicodeError) as error:
            raise RuntimeError("Rust collector returned malformed JSON") from error
        if not isinstance(token, dict) or token.get("eat_profile") != EAT_PROFILE or token.get("binding_suite") != 2:
            raise RuntimeError("Rust collector returned an unexpected composite receipt")
        return token


class AttestHandler(BaseHTTPRequestHandler):
    server_version = "ntrust-attest"
    sys_version = ""

    def setup(self):
        super().setup()
        self.connection.settimeout(10)

    def log_message(self, _format, *_args):
        pass

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.fragment or any(len(self.headers.get_all(name, [])) > 1 for name in ("Host", "Content-Length", "Transfer-Encoding")) or not self.headers.get("Host"):
            return self._send_json(400, {"error": "Ambiguous attestation request"})
        if parsed.path != "/v1/attest":
            return self._send_json(404, {"error": "Not found"})
        if len(self.path) > 256 or self.headers.get("Transfer-Encoding") or self.headers.get("Content-Length", "0") != "0":
            return self._send_json(400, {"error": "Invalid attestation request"})
        try:
            query = parse_qs(parsed.query, keep_blank_values=True, strict_parsing=True)
            if set(query) != {"nonce"} or len(query["nonce"]) != 1:
                raise ValueError("exactly one nonce query parameter is required")
            token = build_rats_evidence(query["nonce"][0])
        except ValueError:
            return self._send_json(400, {"error": "Invalid attestation request"})
        except Exception:
            return self._send_json(503, {"error": "Rust attestation evidence unavailable"})
        self._send_json(200, token)

    def _send_json(self, status: int, payload: dict):
        body = json.dumps(payload, separators=(",", ":")).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)
        self.close_connection = True


def main():
    require_pinned_uq()
    # A local maintained TLS reverse proxy supplies the public endpoint.
    HTTPServer(("127.0.0.1", 8082), AttestHandler).serve_forever()


if __name__ == "__main__":
    main()
