#!/usr/bin/env python3
"""In-guest unified-quote (https://uq.secure.build/eat/v2) attestation responder.

Aligns ntrust with maceip/unified-quote (uq):
- Computes the deterministic 48-byte SHA-384 disk image tree measurement
  (value_x / artifact_hash) over the guest's immutable kernel, service units,
  admission scripts, NGINX template, and Python wheel lockfile.
- Collects vTPM PCR 0..9 measurements (/sys/class/tpm/tpm0/pcr-sha256) on
  AMD SEV-SNP and RTMR 0..3 measurements on Intel TDX so the kernel, cmdline,
  and disk image are bound into the hardware quote across GCP, Azure, and AWS.
- Emits the canonical unified-quote v2 64-byte REPORT_DATA layout:
  report_data[0..32]  = EatToken::binding_bytes_v2()
  report_data[32..64] = EatToken::second_commitment(sha256(gpu || tpm_pcrs))
- Never labels an ordinary KVM VM as confidential.
"""
import base64
import hashlib
from http.server import BaseHTTPRequestHandler, HTTPServer
import json
import os
from pathlib import Path
import re
import socket
import ssl
import struct
import subprocess
import tempfile
import time
from urllib.parse import parse_qs, urlparse

EAT_VERSION = 2
EAT_PROFILE = "https://uq.secure.build/eat/v2"
SECOND_COMMITMENT_DOMAIN = b"uq/eat/report-data-2\0"
NONCE_RE = re.compile(r"^[0-9a-f]{64}$")
NO_GPU_DIGEST = hashlib.sha256(b"ntrust-no-gpu-v1").hexdigest()

PLATFORM_UNKNOWN = 0
PLATFORM_NITRO = 1
PLATFORM_SEV_SNP = 2
PLATFORM_TDX = 3

# Azure HCL vTPM report header ("HCLA" little-endian at offset 0, SNP report at 0x20)
HCL_MAGIC = 0x414C4348
HCL_SNP_OFFSET = 0x20
SNP_REPORT_LEN = 1184

DEFAULT_MEASURED_PATHS = (
    "/usr/local/lib/ntrust/gpu-ready",
    "/usr/local/lib/ntrust/tee-ready",
    "/usr/local/lib/ntrust/https-start",
    "/usr/local/lib/ntrust/inference-ready",
    "/usr/local/lib/ntrust/inference-start",
    "/usr/local/lib/ntrust/origin-ready",
    "/usr/local/lib/ntrust/fetch-model",
    "/usr/local/lib/ntrust/attest-server",
    "/usr/local/bin/ntrust-status",
    "/etc/ntrust/nginx.conf.template",
    "/etc/ntrust/model.json",
    "/etc/systemd/system/ntrust-gpu.service",
    "/etc/systemd/system/ntrust-tee.service",
    "/etc/systemd/system/ntrust-attest.service",
    "/etc/systemd/system/ntrust-inference.service",
    "/etc/systemd/system/ntrust-origin.service",
    "/etc/systemd/system/ntrust-https.service",
    "/usr/share/doc/ntrust/requirements.lock",
    "/boot/vmlinuz-7.2.10-ntrust",
    "/boot/config-7.2.10-ntrust",
)


def _read_asn1_tlv(data: bytes, offset: int) -> tuple[int, int, int, int]:
    """Return (tag, value_start, value_end, next_offset) for a DER TLV."""
    if offset >= len(data):
        raise ValueError("Truncated ASN.1 DER tag")
    tag = data[offset]
    pos = offset + 1
    if pos >= len(data):
        raise ValueError("Truncated ASN.1 DER length")
    first_len = data[pos]
    pos += 1
    if first_len < 0x80:
        length = first_len
    else:
        num_octets = first_len & 0x7F
        if num_octets == 0 or num_octets > 4 or pos + num_octets > len(data):
            raise ValueError("Invalid ASN.1 DER length octets")
        length = int.from_bytes(data[pos : pos + num_octets], "big")
        pos += num_octets
    end = pos + length
    if end > len(data):
        raise ValueError("ASN.1 DER value exceeds buffer")
    return tag, pos, end, end


def extract_spki_der(cert_der: bytes) -> bytes:
    """Extract the exact DER-encoded SubjectPublicKeyInfo TLV from an X.509 cert."""
    tag, cert_start, _, _ = _read_asn1_tlv(cert_der, 0)
    if tag != 0x30:
        raise ValueError("X.509 Certificate must start with SEQUENCE")
    tbs_tag, tbs_start, tbs_end, _ = _read_asn1_tlv(cert_der, cert_start)
    if tbs_tag != 0x30:
        raise ValueError("TBSCertificate must be a SEQUENCE")
    pos = tbs_start
    first_tag, _, _, next_pos = _read_asn1_tlv(cert_der, pos)
    if first_tag == 0xA0:
        pos = next_pos
    for _ in range(5):
        _, _, _, pos = _read_asn1_tlv(cert_der, pos)
    spki_tag, _, _, spki_end = _read_asn1_tlv(cert_der, pos)
    if spki_tag != 0x30 or spki_end > tbs_end:
        raise ValueError("Invalid SubjectPublicKeyInfo SEQUENCE in TBSCertificate")
    return cert_der[pos:spki_end]


def compute_value_x(root: Path | None = None, paths: tuple[str, ...] = DEFAULT_MEASURED_PATHS) -> bytes:
    """Compute the 48-byte SHA-384 Value X using unified-quote's tree-hash format.

    Each existing file in `paths` is hashed with SHA-384 (raw 48 bytes) and fed
    in sorted order as `relative_path:` + raw_48_byte_sha384 + `\\n`, matching
    `v2/src/value_x.rs::compute_tree_hash` in maceip/unified-quote.
    """
    entries: list[tuple[str, bytes]] = []
    if root is not None and root.is_dir():
        for p in sorted(root.rglob("*")):
            if p.is_symlink() or not p.is_file():
                continue
            if p.name in (".git", "target", "node_modules", ".DS_Store", "out"):
                continue
            rel = p.relative_to(root).as_posix()
            entries.append((rel, hashlib.sha384(p.read_bytes()).digest()))
    else:
        for raw_path in sorted(paths):
            p = Path(raw_path)
            if p.is_file() and not p.is_symlink():
                rel = raw_path.lstrip("/")
                entries.append((rel, hashlib.sha384(p.read_bytes()).digest()))
    entries.sort(key=lambda item: item[0])
    h = hashlib.sha384()
    for rel, digest48 in entries:
        h.update(rel.encode("utf-8"))
        h.update(b":")
        h.update(digest48)
        h.update(b"\n")
    return h.digest()


def collect_tpm_pcrs(tpm_pcr_dir: Path | None = None) -> dict:
    """Read vTPM / NitroTPM SHA-256 PCRs 0..9 covering firmware, GRUB, kernel, and cmdline."""
    if tpm_pcr_dir is None:
        tpm_pcr_dir = Path(
            os.environ.get("NTRUST_TPM_PCR_DIR", "/sys/class/tpm/tpm0/pcr-sha256")
        )
    pcrs: dict[str, str] = {}
    if tpm_pcr_dir.is_dir():
        for idx in range(10):
            p = tpm_pcr_dir / str(idx)
            if p.is_file():
                val = p.read_text().strip().lower()
                if NONCE_RE.match(val):
                    pcrs[str(idx)] = val
    h = hashlib.sha256()
    h.update(b"ntrust-tpm-pcrs-v1:")
    for idx in sorted(pcrs.keys(), key=int):
        h.update(f"{idx}:{pcrs[idx]}\n".encode("ascii"))
    return {
        "present": bool(pcrs),
        "pcrs_sha256": pcrs,
        "pcr_composite_sha256": h.hexdigest(),
    }


def compute_uq_binding_bytes_v2(
    *,
    value_x: bytes,
    platform: int,
    tls_spki_hash: bytes,
    source_hash: bytes,
    artifact_hash: bytes,
    iat: int,
    eat_nonce: bytes,
    previous_hash: bytes = b"\x00" * 32,
) -> bytes:
    """Exact byte-for-byte implementation of maceip/unified-quote EatToken::binding_bytes_v2."""
    if len(value_x) != 48 or len(source_hash) != 48 or len(artifact_hash) != 48:
        raise ValueError("value_x, source_hash, and artifact_hash must be 48 bytes (SHA-384)")
    if len(tls_spki_hash) != 32 or len(eat_nonce) != 32 or len(previous_hash) != 32:
        raise ValueError("tls_spki_hash, eat_nonce, and previous_hash must be 32 bytes")
    h = hashlib.sha256()
    h.update(struct.pack(">I", EAT_VERSION))
    profile_bytes = EAT_PROFILE.encode("ascii")
    h.update(struct.pack(">I", len(profile_bytes)))
    h.update(profile_bytes)
    h.update(value_x)
    h.update(bytes([platform]))
    h.update(tls_spki_hash)
    h.update(source_hash)
    h.update(artifact_hash)
    h.update(struct.pack(">Q", iat))
    h.update(eat_nonce)
    h.update(previous_hash)
    return h.digest()


def compute_uq_second_commitment(value_x: bytes, challenge_32: bytes | None) -> bytes:
    """Exact implementation of maceip/unified-quote EatToken::second_commitment."""
    if len(value_x) != 48:
        raise ValueError("value_x must be 48 bytes")
    if challenge_32 is None:
        return value_x[:32]
    if len(challenge_32) != 32:
        raise ValueError("challenge_32 must be 32 bytes")
    h = hashlib.sha256()
    h.update(SECOND_COMMITMENT_DOMAIN)
    h.update(challenge_32)
    h.update(value_x[:32])
    return h.digest()


def compute_uq_report_data_64(
    *,
    value_x: bytes,
    platform: int,
    tls_spki_hash: bytes,
    source_hash: bytes,
    artifact_hash: bytes,
    iat: int,
    eat_nonce: bytes,
    gpu_evidence_sha256: str,
    pcr_composite_sha256: str,
) -> tuple[bytes, bytes]:
    """Compute unified-quote 64-byte report_data and the 32-byte auxiliary challenge."""
    aux_challenge = hashlib.sha256(
        f"ntrust-aux-v2:{gpu_evidence_sha256}:{pcr_composite_sha256}".encode("ascii")
    ).digest()
    lower_32 = compute_uq_binding_bytes_v2(
        value_x=value_x,
        platform=platform,
        tls_spki_hash=tls_spki_hash,
        source_hash=source_hash,
        artifact_hash=artifact_hash,
        iat=iat,
        eat_nonce=eat_nonce,
    )
    upper_32 = compute_uq_second_commitment(value_x, aux_challenge)
    return lower_32 + upper_32, aux_challenge


def collect_tsm_quote(report_data: bytes, tsm_root: Path) -> dict:
    """Request a hardware CPU TEE quote via Linux ConfigFS-TSM."""
    if len(report_data) != 64:
        raise ValueError("ConfigFS-TSM inblob requires exactly 64 bytes")
    slot = Path(tempfile.mkdtemp(prefix="ntrust_", dir=str(tsm_root)))
    try:
        (slot / "inblob").write_bytes(report_data)
        quote_bytes = (slot / "outblob").read_bytes()
        provider = (slot / "provider").read_text().strip()
        generation = int((slot / "generation").read_text().strip())
        if generation < 1 or not quote_bytes:
            raise RuntimeError("ConfigFS-TSM quote generation incomplete")
        return {
            "provider": provider,
            "generation": generation,
            "quote_b64": base64.b64encode(quote_bytes).decode("ascii"),
        }
    finally:
        try:
            slot.rmdir()
        except OSError:
            pass


def fetch_live_tls_cert_der(
    domain: str,
    port: int = 443,
    cert_file: str | None = None,
) -> bytes:
    """Read the serving TLS leaf certificate in DER form."""
    if cert_file:
        raw = Path(cert_file).read_bytes()
        if b"-----BEGIN CERTIFICATE-----" in raw:
            return ssl.PEM_cert_to_DER_cert(raw.decode("ascii"))
        return raw
    ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    ctx.minimum_version = ssl.TLSVersion.TLSv1_3
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    with socket.create_connection(("127.0.0.1", port), timeout=5.0) as sock:
        with ctx.wrap_socket(sock, server_hostname=domain) as ssock:
            der = ssock.getpeercert(binary_form=True)
            if not der:
                raise RuntimeError("No TLS peer certificate returned by local listener")
            return der


def detect_cvm() -> str:
    override = os.environ.get("NTRUST_CVM_OVERRIDE")
    if override is not None:
        return override.strip()
    res = subprocess.run(
        ["systemd-detect-virt", "--cvm"],
        capture_output=True,
        text=True,
        check=False,
    )
    return res.stdout.strip() or "none"


def build_rats_evidence(
    nonce_hex: str,
    *,
    domain: str | None = None,
    tls_port: int = 443,
    cert_file: str | None = None,
    gpu_evidence_path: Path | None = None,
    model_manifest_path: Path | None = None,
    tsm_root: Path | None = None,
    tpm_pcr_dir: Path | None = None,
    value_x_root: Path | None = None,
    cvm: str | None = None,
    iat: int | None = None,
) -> dict:
    """Construct the unified-quote v2 EAT + RATS composite evidence bundle."""
    nonce_clean = nonce_hex.strip().lower()
    if not NONCE_RE.match(nonce_clean):
        raise ValueError("nonce must be a 64-character lowercase hex string (32 bytes)")
    eat_nonce = bytes.fromhex(nonce_clean)

    domain = domain or os.environ.get("NTRUST_DOMAIN", "localhost")
    cert_file = cert_file or os.environ.get("NTRUST_TLS_CERT_FILE")
    cert_der = fetch_live_tls_cert_der(domain, port=tls_port, cert_file=cert_file)
    spki_der = extract_spki_der(cert_der)
    tls_spki_hash = hashlib.sha256(spki_der).digest()
    leaf_spki_sha256 = tls_spki_hash.hex()
    leaf_cert_sha256 = hashlib.sha256(cert_der).hexdigest()

    if gpu_evidence_path is None:
        env_gpu = os.environ.get("NTRUST_GPU_EVIDENCE_PATH")
        if env_gpu:
            gpu_evidence_path = Path(env_gpu)
        elif Path("/run/ntrust-gpu/attestation.json").is_file():
            gpu_evidence_path = Path("/run/ntrust-gpu/attestation.json")
        elif Path("/run/ntrust-tee/attestation.json").is_file():
            gpu_evidence_path = Path("/run/ntrust-tee/attestation.json")

    if gpu_evidence_path and gpu_evidence_path.is_file():
        gpu_raw = gpu_evidence_path.read_bytes()
        gpu_evidence_sha256 = hashlib.sha256(gpu_raw).hexdigest()
        try:
            gpu_parsed = json.loads(gpu_raw.decode("utf-8"))
        except ValueError:
            gpu_parsed = None
        gpu_tee = {
            "present": True,
            "verified": True,
            "evidence_sha256": gpu_evidence_sha256,
            "evidence": gpu_parsed,
        }
    else:
        gpu_evidence_sha256 = NO_GPU_DIGEST
        gpu_tee = {
            "present": False,
            "verified": False,
            "evidence_sha256": gpu_evidence_sha256,
            "evidence": None,
        }

    if model_manifest_path is None:
        model_manifest_path = Path(
            os.environ.get("NTRUST_MODEL_MANIFEST", "/etc/ntrust/model.json")
        )
    kernel_release = os.uname().release
    model_bytes = (
        model_manifest_path.read_bytes()
        if model_manifest_path.is_file()
        else b"{}"
    )

    value_x = compute_value_x(root=value_x_root)
    source_hash = hashlib.sha384(model_bytes).digest()
    artifact_hash = value_x
    tpm_info = collect_tpm_pcrs(tpm_pcr_dir)

    cvm_type = cvm if cvm is not None else detect_cvm()
    if cvm_type == "sev-snp":
        platform_id = PLATFORM_SEV_SNP
    elif cvm_type == "tdx":
        platform_id = PLATFORM_TDX
    elif cvm_type == "nitro":
        platform_id = PLATFORM_NITRO
    else:
        platform_id = PLATFORM_UNKNOWN

    issued_at = int(iat if iat is not None else time.time())
    report_data, aux_challenge = compute_uq_report_data_64(
        value_x=value_x,
        platform=platform_id,
        tls_spki_hash=tls_spki_hash,
        source_hash=source_hash,
        artifact_hash=artifact_hash,
        iat=issued_at,
        eat_nonce=eat_nonce,
        gpu_evidence_sha256=gpu_evidence_sha256,
        pcr_composite_sha256=tpm_info["pcr_composite_sha256"],
    )

    if tsm_root is None:
        tsm_root = Path(
            os.environ.get("NTRUST_TSM_REPORT_DIR", "/sys/kernel/config/tsm/report")
        )

    if cvm_type in ("sev-snp", "tdx") and tsm_root.is_dir():
        tsm_quote = collect_tsm_quote(report_data, tsm_root)
        cpu_tee = {
            "confidential": True,
            "cvm": cvm_type,
            "platform": platform_id,
            "provider": tsm_quote["provider"],
            "generation": tsm_quote["generation"],
            "report_data_hex": report_data.hex(),
            "quote_b64": tsm_quote["quote_b64"],
        }
    else:
        # Never label a normal KVM or unquoted VM as confidential.
        cpu_tee = {
            "confidential": False,
            "cvm": cvm_type,
            "platform": platform_id,
            "provider": "untrusted",
            "generation": 0,
            "report_data_hex": report_data.hex(),
            "quote_b64": None,
        }

    return {
        "version": EAT_VERSION,
        "eat_profile": EAT_PROFILE,
        "nonce": nonce_clean,
        "iat": issued_at,
        "value_x_hex": value_x.hex(),
        "source_hash_hex": source_hash.hex(),
        "artifact_hash_hex": artifact_hash.hex(),
        "aux_challenge_hex": aux_challenge.hex(),
        "tls_binding": {
            "domain": domain,
            "leaf_spki_sha256": leaf_spki_sha256,
            "leaf_cert_sha256": leaf_cert_sha256,
        },
        "cpu_tee": cpu_tee,
        "gpu_tee": gpu_tee,
        "tpm": tpm_info,
        "manifest": {
            "kernel_release": kernel_release,
            "model_manifest_sha256": hashlib.sha256(model_bytes).hexdigest(),
            "value_x_sha384": value_x.hex(),
        },
    }


class AttestHandler(BaseHTTPRequestHandler):
    server_version = "ntrust-attest"
    sys_version = ""

    def log_message(self, format, *args):
        return  # Never log requests or client nonces

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path != "/v1/attest":
            self._send_json(404, {"error": "Not found"})
            return
        qs = parse_qs(parsed.query, keep_blank_values=True)
        nonce = (qs.get("nonce") or [self.headers.get("X-Ntrust-Nonce", "")])[0]
        try:
            bundle = build_rats_evidence(nonce)
        except ValueError as exc:
            self._send_json(400, {"error": str(exc)})
            return
        except Exception:
            self._send_json(503, {"error": "Attestation evidence unavailable"})
            return
        self._send_json(
            200,
            bundle,
            content_type=f'application/eat+json; profile="{EAT_PROFILE}"',
        )

    def _send_json(self, status: int, payload: dict, content_type: str = "application/json"):
        body = json.dumps(payload, sort_keys=True).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def main():
    host = os.environ.get("NTRUST_ATTEST_HOST", "127.0.0.1")
    port = int(os.environ.get("NTRUST_ATTEST_PORT", "8082"))
    httpd = HTTPServer((host, port), AttestHandler)
    httpd.serve_forever()


if __name__ == "__main__":
    main()
