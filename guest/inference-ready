#!/bin/sh
set -eu
# No request text, credential, response body or upstream error enters the journal.
attempt=0
while [ "$attempt" -lt 240 ]; do
    if curl --noproxy '*' --fail --silent --max-time 2 --output /dev/null \
        http://127.0.0.1:8080/health; then
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 1
done
exit 1
