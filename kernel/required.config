# Input to allnoconfig, NOT a distribution defconfig. Unlisted optional
# features start disabled. Kconfig selects the dependency closure.
# x86-64, up to 64 cloud vCPUs, AMD SNP / Intel TDX / Hyper-V / KVM guests.
CONFIG_64BIT=y
CONFIG_EXPERT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_X2APIC=y
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_ACPI=y
CONFIG_DMI=y
CONFIG_DMIID=y
CONFIG_ACPI_NUMA=y
CONFIG_X86_64_ACPI_NUMA=y
CONFIG_NUMA=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_AMD_MEM_ENCRYPT=y
CONFIG_INTEL_TDX_GUEST=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_HYPERV=y
CONFIG_PCI_MMCONFIG=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_250=y
CONFIG_PREEMPT_LAZY=y

# Required process/thread, Python/PyTorch, systemd, SSH and filesystem APIs.
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
# The selected Safetensors loader uses mmap/read; NGINX proxies to loopback.
# Neither selected path requires kernel asynchronous file I/O.
CONFIG_AIO=n
CONFIG_IO_URING=n
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_FHANDLE=y
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SHMEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_UNIX=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_DNOTIFY=n
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EFI_PARTITION=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
# Cloud-init/Packer cidata. Built-in root drivers permit initrdless boot.
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_BLK_DEV_INITRD=n

# Cloud storage and networking; no host virtualization or RDMA stack.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_HYPERV_STORAGE=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_GOOGLE=y
CONFIG_GVE=y
CONFIG_HYPERV_NET=y
CONFIG_VIRTIO_NET=y
# Azure accelerated networking uses the Mellanox Ethernet VF path.
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y
CONFIG_NET_FAILOVER=y
# TLS runs in maintained userspace libraries; no kernel TLS/IPsec stack.
CONFIG_NETFILTER=n
CONFIG_IPV6=n

# NVIDIA headless compute: MMU notifiers, firmware loading, ECC for LKCA.
# HMM is intentionally absent: upstream UVM disables HMM in CC mode.
CONFIG_NTRUST_NVIDIA_UVM=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_SWIOTLB_DYNAMIC=y
CONFIG_MODULES=y
CONFIG_FW_LOADER=y
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_ECDH=m
CONFIG_CRYPTO_ECDSA=m
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
CONFIG_MODULE_UNLOAD=n

# Service isolation and the actual systemd loopback-only egress policy.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_CGROUP_BPF=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_LSM="lockdown,yama,apparmor"
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_KEYS=y

# Keep security hardening and CPU mitigations even when they cost bytes.
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_X86_UMIP=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_BUCKETS=y
CONFIG_LIST_HARDENED=y
CONFIG_KMALLOC_PARTITION_CACHES=y
CONFIG_KMALLOC_PARTITION_RANDOM=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=y
CONFIG_MITIGATION_IBPB_ENTRY=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_SLS=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SRBDS=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_ITS=y

# Explicit forbidden subsystem roots: assertions also check resolved .config.
CONFIG_KVM=n
CONFIG_XEN=n
CONFIG_MSHV_ROOT=n
CONFIG_VIRTUALIZATION=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
CONFIG_HID=n
CONFIG_INPUT=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_WLAN=n
CONFIG_WIRELESS=n
CONFIG_BT=n
CONFIG_INFINIBAND=n
CONFIG_NFS_FS=n
CONFIG_NFSD=n
CONFIG_SMB_SERVER=n
CONFIG_CIFS=n
CONFIG_AFS_FS=n
CONFIG_FUSE_FS=n
CONFIG_OVERLAY_FS=n
CONFIG_BTRFS_FS=n
CONFIG_XFS_FS=n
CONFIG_NETWORK_FILESYSTEMS=n
CONFIG_IP_SCTP=n
CONFIG_RDS=n
CONFIG_TIPC=n
CONFIG_CAN=n
CONFIG_OPENVSWITCH=n
CONFIG_BRIDGE=n
CONFIG_VXLAN=n
CONFIG_WIREGUARD=n
CONFIG_MD=n
CONFIG_BLK_DEV_DM=n
CONFIG_BLK_DEV_INTEGRITY=n
CONFIG_TARGET_CORE=n
CONFIG_NVME_TARGET=n
CONFIG_NVME_TCP=n
CONFIG_SWAP=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_PSTORE=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_KSM=n
CONFIG_TRANSPARENT_HUGEPAGE=n
CONFIG_DEBUG_FS=n
CONFIG_FTRACE=n
# x86 unconditionally selects PERF_EVENTS in this release. No PMU extensions,
# tracing or BPF event attachment; perf_event_open is denied by service policy.
CONFIG_PERF_EVENTS=y
CONFIG_BPF_EVENTS=n
CONFIG_BPF_STREAM_PARSER=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_ACPI_DEBUG=n
CONFIG_ACPI_DEBUGGER=n
CONFIG_HMM_MIRROR=n
CONFIG_DEVICE_PRIVATE=n
CONFIG_ZONE_DEVICE=n
CONFIG_COREDUMP=n
CONFIG_DEVMEM=n
CONFIG_DEVPORT=n
CONFIG_IA32_EMULATION=n
CONFIG_X86_X32_ABI=n
CONFIG_LOCALVERSION="-ntrust"
CONFIG_LOCALVERSION_AUTO=n
